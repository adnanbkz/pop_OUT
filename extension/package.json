{
  "name": "pop-out-extension",
  "version": "0.1.0",
  "private": true,
  "description": "pop_OUT browser extension: a local-only focus timer with a pet that pulls you out of autopilot.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "pets": "node scripts/make-pip.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3"
  }
